# ─────────────────────────────────────────────────────────────────────────────
# clack. environment
# Everything is optional. With nothing set, the app runs fully anonymous and
# stores history in the browser. Add a database + Clerk for accounts & sync.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Neon, Supabase, Vercel Postgres, Railway…).
# Use the *direct* (non-pooled) URL if your provider gives you two; migrations
# need a direct connection.
DATABASE_URL=

# Clerk authentication (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: skip `prisma migrate deploy` during the build (e.g. previews).
# SKIP_MIGRATIONS=1

# Local testing only. Never set in production (it is ignored there anyway).
# CLACK_DEV_AUTH=1
